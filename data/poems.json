    "id": "poem7",
    "title": "西施咏",
    "author": "[唐] 王维",
    "form": "五言古诗",
    "lines": [
      "艳色天下重，",
      "西施宁久微？",
      "朝为越溪女，",
      "暮作吴宫妃。",
      "贱日岂殊众？",
      "贵来方悟稀。",
      "邀人傅香粉，",
      "不自著罗衣。",
      "君宠益骄态，",
      "君怜无是非。",
      "当时浣纱伴，",
      "莫得同车归。",
      "持谢邻家子，",
      "效颦安可希？"
    ],
